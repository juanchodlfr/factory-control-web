{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factory-control-web",
  "compatibility_date": "2026-09-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oauth/consent"]
  }
}
